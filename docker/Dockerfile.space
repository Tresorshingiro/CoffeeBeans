FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    API_BASE=http://127.0.0.1:8000 \
    HOME=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY api/ ./api/
COPY ui/ ./ui/
COPY scripts/ ./scripts/
COPY models/ ./models/
COPY data/ ./data/
COPY docker/nginx.space.conf ./docker/nginx.space.conf
COPY docker/start.sh ./docker/start.sh

# Arm the promotion gate at build time, not on every boot. Scoring the baseline
# against the 400-image eval slice takes minutes on a Space's 2 vCPU, and doing
# it in start.sh means nginx does not bind :7860 until it finishes — the Space
# sits on "Starting" with nothing to show. Baking data/app.db into the image
# also means a restart on ephemeral storage comes back with a registered
# champion instead of an empty registry, where the gate would compare every
# candidate against 0.0 and promote it regardless of quality.
# No `|| true` on purpose: an unarmed gate should fail the build, not ship.
RUN python scripts/register_baseline.py

RUN chmod +x docker/start.sh \
    && mkdir -p /app/data/pending /var/lib/nginx /var/log/nginx \
    && chmod -R 777 /app/data /var/lib/nginx /var/log/nginx

EXPOSE 7860
CMD ["./docker/start.sh"]
